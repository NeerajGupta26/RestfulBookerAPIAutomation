pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/NeerajGupta26/RestfulBookerAPIAutomation.git'
            }
        }

        stage('Build') {
            steps {
                bat 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                bat 'mvn test'
            }
        }

        stage('Report') {
            steps {
                archiveArtifacts artifacts: 'reports/**', fingerprint: true
                archiveArtifacts artifacts: 'logs/**', fingerprint: true
            }
        }

    }

    post {

        always {

            junit 'target/surefire-reports/*.xml'

        }

    }



}
